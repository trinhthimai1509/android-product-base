<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No <uses-permission> here: INTERNET and ACCESS_NETWORK_STATE come from core:network and
      POST_NOTIFICATIONS from core:notification, so dropping a capability module also drops its
      permissions from the merged manifest.
    -->

    <application
        android:name=".DemoApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProductBaseDemo">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ProductBaseDemo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Opened by a scheduled reminder. The scheme is app-specific and the notification's
              PendingIntent sets the package explicitly, so no other app can be launched by it.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="infrastructure"
                    android:scheme="productbase-demo" />
            </intent-filter>
        </activity>
    </application>

</manifest>
