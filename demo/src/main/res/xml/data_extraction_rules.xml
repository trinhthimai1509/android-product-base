<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup behaviour is declared explicitly rather than left to the platform default.
  The demo shell opts out of both cloud backup and device-to-device transfer; a real product
  should decide deliberately and document the choice in its Play Data Safety form.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
